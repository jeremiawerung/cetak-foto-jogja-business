APP_NAME="Cetak Foto Jogja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nomor WhatsApp admin, format internasional tanpa tanda + (62 = kode Indonesia)
WHATSAPP_NUMBER=62895708600900

# Data toko - dipakai di label pengiriman (bagian "Pengirim").
TOKO_NAMA="Cetak Foto Jogja"
TOKO_ALAMAT="Jl. Tempel, Gendol, Margorejo, Kec. Tempel, Kabupaten Sleman, Daerah Istimewa Yogyakarta 55552"

# Airtable dipakai sebagai log/rekap order ringan (opsional).
# Kosongkan jika belum ingin dipakai, sistem tetap jalan tanpa Airtable.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_CETAK_FOTO="Order Cetak Foto"
AIRTABLE_TABLE_SEWA_FOTOGRAFER="Booking Sewa Fotografer"

# Rekening tujuan transfer pembayaran manual, ditampilkan di form order cetak foto.
# GANTI ke rekening asli sebelum go-live.
BANK_NAMA="BCA"
BANK_NO_REKENING="1234567890"
BANK_ATAS_NAMA="Cetak Foto Jogja"

# Gambar QRIS statis, taruh file asli di public/images/pembayaran/qris.png
QRIS_GAMBAR="images/pembayaran/qris.png"

# RajaOngkir v2 (by Komerce). Ambil API key di dashboard Komerce > Developer > API Key.
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"
RAJAONGKIR_API_KEY=
# ID subdistrict asal (toko), cari lewat endpoint /destination/domestic-destination.
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN_LABEL=
RAJAONGKIR_COURIER="jne:jnt:sicepat:anteraja:ninja"

# API key DeepSeek, dipakai fitur "Verifikasi dengan AI" di modul QA Kartu Pelajar
# (/internal/kartu-pelajar, saat ini dorman/nonaktif). Dapatkan di platform.deepseek.com.
# Kosongkan jika belum ingin dipakai — tombol verifikasi akan menampilkan pesan
# "belum dikonfigurasi", bukan error.
DEEPSEEK_API_KEY=
# KARTU_PELAJAR_AI_MODEL=deepseek-flash

# Fitur "Verifikasi Siswa" (/internal/verifikasi-siswa) — sinkron otomatis respons Google
# Form via Google Sheets API. Butuh file kredensial Service Account (dari Google Cloud
# Console: buat project -> aktifkan Google Sheets API -> buat Service Account -> download
# JSON -> simpan di path ini -> share Google Sheet respons form ke email service account
# itu, akses Viewer). Kosongkan/biarkan default jika fiturnya belum di-setup.
# GOOGLE_SERVICE_ACCOUNT_PATH=storage/app/google/service-account.json
# VERIFIKASI_SISWA_SYNC_INTERVAL=15
